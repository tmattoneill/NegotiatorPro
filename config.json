{
  "app": {
    "name": "NegotiatorPro",
    "description": "AI-powered negotiation guidance",
    "version": "1.0.0",
    "environment": "development"
  },
  "ui": {
    "theme": {
      "primaryColor": "#3498db",
      "sidebarColor": "#191919",
      "backgroundColor": "#efefef",
      "textColor": "#191919",
      "secondaryColor": "#9fadbd",
      "accentColor": "#b68947",
      "highlightColor": "#7e5716"
    },
    "features": {
      "enableUserProfiles": true,
      "enableModelSelection": true,
      "enableTextOptimization": true,
      "enablePremiumModels": true,
      "enableConversationHistory": true
    },
    "limits": {
      "maxMessageLength": 10000,
      "maxConversationsPerUser": 100,
      "sessionTimeoutMinutes": 60
    }
  },
  "defaults": {
    "default_provider": "ollama-cloud",
    "default_model": "gpt-oss:120b-cloud",
    "premium_provider": "anthropic",
    "premium_model": "claude-sonnet-4-5",
    "enable_text_preprocessing": true,
    "max_tokens": 4096,
    "temperature": 0.7,
    "streaming_enabled": true
  },
  "negotiation": {
    "framework": "PLEASE",
    "response_format": {
      "include_analysis": true,
      "include_questions": true,
      "include_draft_response": true,
      "include_scenarios": true,
      "include_self_assessment": true
    },
    "analysis_elements": [
      "Context",
      "Stakeholder Identification",
      "Current Position",
      "Potential Interests",
      "Emotional Tone",
      "Power Balance"
    ],
    "self_assessment_criteria": [
      "Polite",
      "Logical",
      "Empathetic",
      "Assertive",
      "Strategic",
      "Engaging"
    ]
  },
  "security": {
    "jwt_expiration_minutes": 30,
    "session_timeout_minutes": 60,
    "password_min_length": 8,
    "require_email_verification": false,
    "max_login_attempts": 5,
    "lockout_duration_minutes": 15
  },
  "database": {
    "pool_min_size": 2,
    "pool_max_size": 10,
    "command_timeout_seconds": 60
  },
  "rag": {
    "chunk_size": 1000,
    "chunk_overlap": 200,
    "retrieval_k": 5,
    "preprocess_min_length": 100
  },
  "uploads": {
    "max_file_size_mb": 50,
    "supported_extensions": [".pdf", ".txt", ".docx", ".doc"]
  },
  "embedding": {
    "vectorstore_dir": "vectorstore",
    "default_model": "text-embedding-3-large",
    "fallback_model": "text-embedding-ada-002"
  },
  "admin": {
    "default_username": "admin",
    "default_email": "test@example.com",
    "allow_user_registration": true,
    "require_admin_approval": false
  }
}
