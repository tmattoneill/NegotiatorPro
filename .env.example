# ========================================
# NegotiatorPro Environment Configuration
# ========================================

# ========================================
# Application Environment
# ========================================
# Set to "production" for production deployments
# In production, security-critical variables are REQUIRED
APP_ENV=development

# ========================================
# Security (REQUIRED in production)
# ========================================
# JWT secret key for authentication tokens
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# Admin user password (set during initialization)
# In development, defaults to "admin123" if not set
ADMIN_PASSWORD=

# Admin email (optional)
ADMIN_EMAIL=admin@negotiatorpro.local

# ========================================
# CORS Configuration
# ========================================
# Comma-separated list of allowed origins
# In development, defaults to localhost if not set
# REQUIRED in production - set to your domain(s)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ========================================
# Docker Port Configuration
# ========================================
# Override default ports if needed (e.g., to avoid conflicts)
# POSTGRES_HOST_PORT=5432
# API_HOST_PORT=8000
# FRONTEND_HOST_PORT=5173

# ========================================
# Database Configuration (PostgreSQL)
# ========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=negotiatorpro
POSTGRES_USER=negotiatorpro
# REQUIRED - no default in production
POSTGRES_PASSWORD=

# Database URL (alternative to individual settings)
# DATABASE_URL=postgresql://negotiatorpro:password@localhost:5432/negotiatorpro

# ========================================
# Encryption
# ========================================
# Encryption key for storing user API keys securely
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ========================================
# LLM Backend Configuration
# ========================================

# OpenAI API Key (for GPT models)
OPENAI_API_KEY=

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=

# DeepSeek API Key (for DeepSeek V4 Pro / Flash)
# Get key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  # override if needed

# Ollama Local (for self-hosted models)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama Cloud (for cloud-hosted Ollama models)
# Get your API key from: https://ollama.com/settings/keys
OLLAMA_CLOUD_URL=https://ollama.com
OLLAMA_API_KEY=

# RunPod (Basic fallback - used when no other backends are available)
# Get your API key from: https://www.runpod.io/console/user/settings
# This provides a basic LLM fallback even without OpenAI/Anthropic/Ollama
RUNPOD_API_KEY=
# Optional: Override the default RunPod endpoint ID
# RUNPOD_ENDPOINT_ID=

# ========================================
# JWT Configuration (optional overrides)
# ========================================
# JWT_TOKEN_EXPIRE_MINUTES=30

# ========================================
# Admin Configuration (optional overrides)
# ========================================
# ADMIN_SESSION_DURATION_HOURS=24
# ADMIN_MAX_UPLOAD_MB=50

# ========================================
# Corpus location
# ========================================
# Path to the RAG source corpus. Defaults to ../data-sources (sibling of project
# root). Inside Docker, this is overridden to /app/data-sources via the bind
# mount in docker-compose.yml.
# DATA_SOURCES_DIR=../data-sources

# ========================================
# Bunny Storage (offsite corpus / assets — backend/storage.py)
# ========================================
# Canonical home of the RAG corpus (and later vectorstore / uploads) so admin
# works from any machine. The backend reads/writes via the Storage API; if these
# are unset it falls back to local-filesystem behaviour.
# BUNNY_NET_URL=https://uk.storage.bunnycdn.com/<storage-zone>
# BUNNY_NET_RO_PASSWORD=   # read-only storage AccessKey (get/list)
# BUNNY_NET_RW_PASSWORD=   # read-write storage AccessKey (put/delete) — needed for uploads
# BUNNY_NET_PULL_ZONE=     # pull-zone host/custom domain for browser URLs, e.g. data.amfonica.com
# BUNNY_NET_API_KEY=       # account API key (managing zones; not needed at runtime)
