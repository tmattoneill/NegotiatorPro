# ========================================
# LLM Backend Configuration
# ========================================

# System-Level API Keys (Base Service)
# These are used for default/free models available to all users

# Ollama Cloud (Base Service - REQUIRED)
# Get your API key from: https://ollama.com/settings/keys
OLLAMA_CLOUD_URL=https://ollama.com
OLLAMA_API_KEY=your_ollama_cloud_api_key_here

# Ollama Local (Optional - for development)
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ========================================
# User-Level API Keys (Premium Services)
# ========================================
# OpenAI and Anthropic keys are stored PER-USER in PostgreSQL (encrypted)
# Users enter their own premium API keys via the user profile
# See: scripts/setup_my_user.py to configure your personal keys

# ========================================
# Server Configuration
# ========================================
GRADIO_SERVER_PORT=7860

# ========================================
# Database Configuration (PostgreSQL)
# ========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=negotiatorpro
POSTGRES_USER=negotiatorpro
POSTGRES_PASSWORD=your_secure_password_here

# Database URL (alternative to individual settings)
# DATABASE_URL=postgresql://negotiatorpro:password@localhost:5432/negotiatorpro

# Encryption key for API keys (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_encryption_key_here