# ========================================
# LLM Backend Configuration
# ========================================

# OpenAI Configuration (Default)
OPENAI_API_KEY=your_openai_api_key_here
# Optional: Custom OpenAI endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude Configuration
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: Custom Anthropic endpoint
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Ollama Configuration (Local)
# Default: http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434

# Ollama Cloud Configuration
# Get your API key from: https://ollama.com/settings/keys
# For cloud models like gpt-oss:120b-cloud, use the ollama-cloud backend
# OLLAMA_CLOUD_URL=https://ollama.com
# OLLAMA_API_KEY=your_ollama_api_key_here

# ========================================
# Server Configuration
# ========================================
GRADIO_SERVER_PORT=7860

# ========================================
# Database Configuration (PostgreSQL)
# ========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=negotiatorpro
POSTGRES_USER=negotiatorpro
POSTGRES_PASSWORD=your_secure_password_here

# Database URL (alternative to individual settings)
# DATABASE_URL=postgresql://negotiatorpro:password@localhost:5432/negotiatorpro